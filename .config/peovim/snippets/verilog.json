    "testbench template": {
        "prefix": "tb",
        "body": [
            "`include \"$CURSORPOS.v\"",
            "`default_nettype none",
            "",
            "module tb_FIXME;",
            "reg clk;",
            "reg rst_n;",
            "",
            "FIXME FIXME",
            "(",
            "  .rst_n (rst_n),",
            "  .clk (clk),",
            ");",
            "",
            "localparam CLK_PERIOD = 10;",
            "always #(CLK_PERIOD/2) clk=~clk;",
            "",
            "initial begin",
            "  $dumpfile(\"tb_FIXME.vcd\");",
            "  $dumpvars(0, tb_FIXME);",
            "end",
            "",
            "initial begin",
            "  #1 rst_n<=1'bx;clk<=1'bx;",
            "  #(CLK_PERIOD*3) rst_n<=1;",
            "  #(CLK_PERIOD*3) rst_n<=0;clk<=0;",
            "  repeat(5) @(posedge clk);",
            "  rst_n<=1;",
            "  @(posedge clk);",
            "  repeat(2) @(posedge clk);",
            "  $finish(2);",
            "end",
            "",
            "endmodule",
            "`default_nettype wire"
        ],
        "description": "testbench template"
    },

    "state_machine template": {
        "prefix": "sm",
        "body": [
            "// State Machine States",
            "localparam S_IDLE       = 4'd0;",
            "localparam S_ONE        = 4'd1; //",
            "localparam S_TWO        = 4'd2; //",
            "",
            "// misc helpers",
            "",
            "reg [3:0] state_m = S_IDLE;",
            "always @(posedge FIXME)",
            "    if (FIXME)",
            "        begin",
            "        state_m <= S_IDLE;",
            "        end",
            "    else",
            "        case (state_m)",
            "",
            "            S_IDLE:",
            "                begin",
            "                state_m <= S_IDLE;",
            "                end",
            "",
            "            S_ONE:",
            "                begin",
            "                state_m <= S_IDLE;",
            "                end",
            "",
            "            S_TWO:",
            "                begin",
            "                state_m <= S_IDLE;",
            "                end",
            "",
            "            default:",
            "                begin",
            "                state_m <= S_IDLE;",
            "                end",
            "",
            "        endcase"
        ],
        "description": "state machine example"
    }

