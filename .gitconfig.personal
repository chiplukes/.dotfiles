# Applied to any repo under projects/personal/** (see includeIf in ~/.gitconfig).
# Switches the github.com/gist.github.com credential helper to GCM-only mode
# instead of `gh`, so pushes here authenticate as whichever GitHub account you
# log into via the normal browser prompt, independent of gh's currently
# "active" account (which is your work account, chiplukes-sphere).
# Goes through .git-credential-helper rather than `helper = manager` because
# `manager` only resolves where GCM is on git's exec path (not WSL, plain
# Linux, or Git for Windows < 2.39).
[credential "https://github.com"]
	helper =
	helper = !"$HOME/.git-credential-helper" --gcm
[credential "https://gist.github.com"]
	helper =
	helper = !"$HOME/.git-credential-helper" --gcm
