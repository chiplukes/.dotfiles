#!/usr/bin/env bash
# .git-credential-helper — cross-platform credential.helper dispatch.
#
# Tracked in dotfiles (rather than a per-machine, untracked ~/.gitconfig.local)
# so every machine gets the same github.com/gist.github.com credential
# routing straight from `dotfiles clone`/`pull` — no manual per-machine setup.
#
# Usage (from gitconfig):  helper = !"$HOME/.git-credential-helper" [--gcm]
#
# Default mode:
# - WSL: delegate to the Windows Git Credential Manager via /mnt/c interop.
#   Shares the same credential store as native Windows git (same GCM binary,
#   same Windows Credential Manager backing it), so a login on one side is
#   visible on the other. Falls back to gh if no Windows GCM is found.
# - Windows (git-bash) and plain Linux: delegate to `gh auth git-credential`
#   when gh is on PATH, else GCM.
#
# --gcm mode (used by .gitconfig.personal and the dotfiles repo): GCM only,
# never gh — skips whichever GitHub account gh currently has active (work, by
# default) so you get GCM's normal account picker instead.
#
# GCM is located rather than assumed: its file name and directory differ
# between Git for Windows versions (<2.39 ships git-credential-manager-core.exe
# in libexec/git-core, newer ships git-credential-manager.exe in mingw64/bin),
# and it may be a standalone install, a per-user install, or absent entirely
# (plain Linux). Never hardcode `helper = manager` in gitconfig for the same
# reason — it fails with "'credential-manager' is not a git command" anywhere
# GCM isn't on git's exec path.
#
# If nothing usable is found, print a hint and exit 0 with no output, so git
# falls back to its normal username/password (token) prompt instead of erroring.
set -uo pipefail

mode=default
if [ "${1:-}" = "--gcm" ]; then
    mode=gcm
    shift
fi

is_wsl() { grep -qi microsoft /proc/version 2>/dev/null; }

find_gcm() {
    local c root exec_path
    local -a candidates=()
    if is_wsl; then
        for root in "/mnt/c/Program Files/Git" "/mnt/c/Program Files (x86)/Git" \
                    /mnt/c/Users/*/AppData/Local/Programs/Git; do
            candidates+=("$root/mingw64/bin/git-credential-manager.exe"
                         "$root/mingw64/libexec/git-core/git-credential-manager.exe"
                         "$root/mingw64/libexec/git-core/git-credential-manager-core.exe")
        done
        candidates+=("/mnt/c/Program Files (x86)/Git Credential Manager/git-credential-manager.exe"
                     "/mnt/c/Program Files/Git Credential Manager/git-credential-manager.exe")
    else
        exec_path=$(git --exec-path 2>/dev/null)
        if [ -n "$exec_path" ]; then
            candidates+=("$exec_path/git-credential-manager"
                         "$exec_path/git-credential-manager-core")
        fi
    fi
    for c in git-credential-manager git-credential-manager-core; do
        c=$(command -v "$c" 2>/dev/null) && candidates+=("$c")
    done
    for c in "${candidates[@]}"; do
        if [ -x "$c" ] || [ -x "$c.exe" ]; then
            printf '%s\n' "$c"
            return 0
        fi
    done
    return 1
}

have_gh() { command -v gh >/dev/null 2>&1; }

if [ "$mode" = default ] && ! is_wsl && have_gh; then
    exec gh auth git-credential "$@"
fi

if gcm=$(find_gcm); then
    exec "$gcm" "$@"
fi

if [ "$mode" = default ] && have_gh; then
    exec gh auth git-credential "$@"
fi

if [ "${1:-}" = get ]; then
    echo ".git-credential-helper: no Git Credential Manager found ($mode mode); falling back to git's prompt" >&2
fi
exit 0
