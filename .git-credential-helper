#!/usr/bin/env bash
# .git-credential-helper — cross-platform credential.helper dispatch.
#
# Tracked in dotfiles (rather than a per-machine, untracked ~/.gitconfig.local)
# so every machine gets the same github.com/gist.github.com credential
# routing straight from `dotfiles clone`/`pull` — no manual per-machine setup.
#
# - WSL: delegate to the Windows Git Credential Manager via the /mnt/c
#   interop path. Shares the same credential store as native Windows git
#   (same GCM binary, same Windows Credential Manager backing it), so a
#   login on one side is visible on the other.
# - Windows (git-bash) and plain Linux: delegate to `gh auth git-credential`
#   when gh is on PATH. This is what makes .gitconfig.personal's override to
#   `manager` meaningful for projects/personal/** — it skips whichever
#   GitHub account gh currently has active (work, by default).
# - Anywhere gh isn't available: fall back to git's own credential-manager.
set -euo pipefail

win_gcm="/mnt/c/Program Files/Git/mingw64/bin/git-credential-manager.exe"

if grep -qi microsoft /proc/version 2>/dev/null && [ -x "$win_gcm" ]; then
    exec "$win_gcm" "$@"
elif command -v gh >/dev/null 2>&1; then
    exec gh auth git-credential "$@"
else
    exec git-credential-manager "$@"
fi
